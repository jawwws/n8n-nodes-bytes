{
  "name": "@jawwws/n8n-nodes-bytes",
  "version": "0.1.0",
  "description": "n8n community node for the Jawwws Bytes Developer API",
  "license": "MIT",
  "homepage": "https://developer.jaww.ws/",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "jawwws",
    "bytes",
    "qr-code",
    "physical-to-digital"
  ],
  "author": {
    "name": "Jawwws Ltd",
    "email": "support@jawwws.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jawwws/n8n-nodes-bytes.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "test": "node --test test/*.node-test.cjs",
    "check": "npm run lint && npm run build && npm test"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/JawwwsBytesApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/JawwwsBytes/JawwwsBytes.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.52.5",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "release-it": "20.2.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
